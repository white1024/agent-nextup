{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and runtime terminal pop-out windows (B16-C)",
  "windows": ["main", "terminal-popout-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default"
  ]
}
